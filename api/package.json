{
  "name": "ideas",
  "version": "0.0.0",
  "description": "An app to learn nest.",
  "author": "Pedro Rio",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "nodemon",
    "start:debug": "nodemon --config nodemon-debug.json",
    "prestart:prod": "rimraf dist && npm run build",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node test/run-e2e.js",
    "test:migration": "node -r ts-node/register -r tsconfig-paths/register test/schema-migration.e2e.js",
    "test:votes": "node -r ts-node/register -r tsconfig-paths/register test/idea-votes.e2e.js",
    "test:auth": "node -r ts-node/register -r tsconfig-paths/register test/auth-guard.e2e.js",
    "migration:run": "node -r ts-node/register -r tsconfig-paths/register scripts/run-migrations.js"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.0.3",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/graphql": "14.0.3",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/typeorm": "12.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.3.1",
    "class-validator": "^0.9.1",
    "express-rate-limit": "^3.3.2",
    "graphql": "16.14.2",
    "helmet": "^3.15.0",
    "jsonwebtoken": "^8.4.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rimraf": "^2.6.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@nestjs/testing": "12.2.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/express": "^4.16.0",
    "@types/helmet": "^0.0.42",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^8.3.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^2.0.5",
    "eslint": "9.39.5",
    "jest": "^29.7.0",
    "nodemon": "^1.18.3",
    "prettier": "^1.14.2",
    "supertest": "^3.1.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^3.5.0",
    "typescript-eslint": "8.72.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": "<rootDir>/../test/jest-esm-transformer.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@nestjs|@apollo)/)"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
